IDENTIFICATION DIVISION.
PROGRAM-ID. INTER-BRANCH-TRANSFER.
DATA DIVISION.
    WORKING-STORAGE SECTION.
        01 N PIC 9(1).
        01 I PIC 9(1).
        01 TID PIC X(5).
        01 OUTGOING PIC 9(12).
        01 INCOMING PIC 9(12).
        01 DIFF PIC S9(4).
        01 MC PIC 9(1).
        01 MMC PIC 9(1).
PROCEDURE DIVISION.
    DISPLAY "ENTER YOUR NUMBER :"
    ACCEPT N
    PERFORM VARYING I FROM 1 BY 1
    UNTIL I>N
    DISPLAY "ENTER TID :"
    ACCEPT TID
    DISPLAY "ENTER OUTGOING :"
    ACCEPT OUTGOING
    DISPLAY "ENTER INCOMING :"
    ACCEPT INCOMING
    
    IF OUTGOING = INCOMING
        DISPLAY FUNCTION TRIM(TID) " MATCHED"
        ADD 1 TO MC
    ELSE 
        COMPUTE DIFF = INCOMING - OUTGOING
        DISPLAY FUNCTION TRIM(TID) " DIFFERENCE :" FUNCTION TRIM(DIFF)
        ADD 1 TO MMC
    END-IF
    END-PERFORM
    
    DISPLAY "MATCHED :" FUNCTION TRIM(MC)
    DISPLAY "MISMATCHED :" FUNCTION TRIM(MMC)

STOP RUN.


