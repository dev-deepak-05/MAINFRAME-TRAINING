IDENTIFICATION DIVISION.
PROGRAM-ID. SELECT-CHOICE.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-CHOICE PIC 9.
01 WS-BALANCE PIC 9(7) VALUE 50000.
01 WS-AMOUNT PIC 9(6).
01 WS-WITHDRAW-LIMIT PIC 9(5) VALUE 10000.
PROCEDURE DIVISION.
PERFORM UNTIL WS-CHOICE = 5
DISPLAY "====BANK MENU===="
DISPLAY "1.CHECK BALANCE"
DISPLAY "2.DEPOSIT"
DISPLAY "3.WITHDRAW"
DISPLAY "4.CHECK MAXIMUM WITHDRAWAL LIMIT"
DISPLAY "5.EXIT"
DISPLAY "================="
DISPLAY "ENTER THE CHOICE : "
ACCEPT WS-CHOICE

    EVALUATE WS-CHOICE
        WHEN 1
            DISPLAY "BALANCE : " WS-BALANCE
        WHEN 2
            DISPLAY "ENTER DEPOSIT AMOUNT : "
            ACCEPT WS-AMOUNT
            IF WS-AMOUNT > 0
                COMPUTE WS-BALANCE = WS-BALANCE + WS-AMOUNT
                DISPLAY "DEPOSIT SUCCESSFUL"
                DISPLAY "BALANCE :" WS-BALANCE
            ELSE
                DISPLAY "ENTER VALID AMOUNT TO DEPOSIT"
            END-IF
        WHEN 3
            DISPLAY "ENTER WITHDRAW AMOUNT : "
            ACCEPT WS-AMOUNT
            IF WS-AMOUNT > 0 AND WS-AMOUNT <= WS-BALANCE AND WS-AMOUNT <= WS-WITHDRAW-LIMIT
                COMPUTE WS-BALANCE = WS-BALANCE - WS-AMOUNT
                DISPLAY "WITHDRAW SUCCESSFUL"
                DISPLAY "BALANCE : " WS-BALANCE
            ELSE
                DISPLAY "ENTER VALID AMOUNT OR LESS THAN 10,000 TO WITHDRAW"
            END-IF
        WHEN 4
            DISPLAY "MAXIMUM WITHDRAWAL LIMIT : " WS-WITHDRAW-LIMIT
        WHEN 5
            DISPLAY "THANK YOU FOR BANKING"
        WHEN OTHER
            DISPLAY "INVALID OPTION"
    END-EVALUATE
END-PERFORM.

STOP RUN.