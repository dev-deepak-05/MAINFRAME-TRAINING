IDENTIFICATION DIVISION.
PROGRAM-ID. BANK-WITHDRAWAL.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-INITIAL-BALANCE PIC 9(6).
01 WS-WITHDRAW PIC 9(6).
01 WS-BALANCE PIC 9(6).
PROCEDURE DIVISION.
DISPLAY "ENTER YOUR BALANCE AMOUNT : ".
ACCEPT WS-INITIAL-BALANCE.
DISPLAY "ENTER THE WITHDRAW AMOUNT : ".
ACCEPT WS-WITHDRAW.

IF WS-WITHDRAW <= 0
    DISPLAY "ENTER VALID WITHDRAW AMOUNT"
ELSE
    IF WS-INITIAL-BALANCE >= WS-WITHDRAW
        COMPUTE WS-BALANCE = WS-INITIAL-BALANCE - WS-WITHDRAW
        DISPLAY "THE CURRENT BALANCE IS : " WS-BALANCE
    ELSE
        DISPLAY "INSUFFICIENT BALANCE"
    END-IF
END-IF.

STOP RUN.
